{
  "_doc": "poem2video 风格库。每个风格同时定义：① image_* 用于向 ImageGen 生成画作；② font/palette/caption/card 用于帧合成与渲染。新增风格只需在此追加一项，脚本无需改动。",
  "_fields": {
    "image_prefix": "生图提示词的风格前缀（必带画种与介质描述）",
    "image_suffix": "生图提示词的收尾约束（无文字、无水印、构图等）",
    "size": "建议生图尺寸",
    "aspect": "画幅比例",
    "palette.paper": "文字卡底色（宣纸/底材）RGB",
    "palette.ink/mid/faint": "三级文字色，由重到轻",
    "palette.seal_fill/seal_text": "印章底色/字色",
    "font.family": "字体族键，见 lib_common.FONT_FAMILIES",
    "font.heavy/regular/light": "该字体族内的字面 index",
    "caption": "字幕条样式（scrim=底部渐变压暗；underline=是否画装饰线）",
    "card": "文字卡（片头/片尾/作者）的虚化底与罩层参数"
  },

  "ink": {
    "name": "水墨国画",
    "desc": "宣纸质感、浓淡墨色、大面积留白。最贴古诗气质，动效自然，是默认首选。",
    "tags": ["极简", "典雅", "留白", "黑白灰"],
    "image_prefix": "中国水墨国画风格，横构图画作。以浓淡墨色在宣纸上晕染，笔触疏朗写意，",
    "image_suffix": "色彩仅黑、白、灰墨色（可极少量淡赭色点睛），绝无鲜艳色彩。大面积留白表现空寂与天光，远景淡墨、近景浓墨，讲究虚实与纵深。传统中国画构图，意境清冷深远。画面中不要出现任何文字、印章、签名、水印或边框。",
    "size": "1536x1024",
    "aspect": "3:2",
    "palette": {
      "paper": [245, 241, 232],
      "ink": [40, 40, 40],
      "mid": [92, 90, 86],
      "faint": [150, 146, 138],
      "seal_fill": [166, 58, 43],
      "seal_text": [245, 241, 232]
